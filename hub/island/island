#!/usr/bin/env python3
"""Island: a notch-like pill at the top centre of the screen, over the middle of waybar.

Usage: island                    start it; running it again turns it off
       island timer DURATION     start a timer: 90s, 7m, 1h30m or plain minutes (starts the island)
       island timer stop|pause|+5m
       island toggle             expand or collapse the card (keeps it open)
       island status [timer]     print what the island shows, nothing when it is idle
                                 (timer-raw: seconds left, total and paused flag)

It stays hidden while there is nothing to show. It shows the playing track (cover,
progress, controls), a timer, a running screen recording from `capture`, and a short
glimpse of each incoming notification. Hover to expand, click the pill to keep it open.
Works on niri and Hyprland (gtk4-layer-shell).
"""
import math
import os
import re
import signal
import subprocess
import sys
import threading
import time
import urllib.request
from ctypes import CDLL

# gtk4-layer-shell must be loaded before libwayland-client, i.e. before Gtk is imported
CDLL('libgtk4-layer-shell.so')

import gi  # noqa: E402

gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
gi.require_version('GdkPixbuf', '2.0')
gi.require_version('Gtk4LayerShell', '1.0')
gi.require_version('Playerctl', '2.0')
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango, Playerctl  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
HUB = os.path.dirname(HERE)
REC = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'hub', 'rec')
TIMER = os.path.join(os.path.dirname(REC), 'timer')
SOUND = '/usr/share/sounds/freedesktop/stereo/complete.oga'

NOTIFY_SECONDS = 4
PAUSED_LINGER = 8
EXPAND_DELAY = 120
COLLAPSE_DELAY = 350


def clock(seconds):
    seconds = max(0, int(seconds + 0.5))
    h, rest = divmod(seconds, 3600)
    return f'{h}:{rest // 60:02}:{rest % 60:02}' if h else f'{rest // 60}:{rest % 60:02}'


def parse_duration(text):
    text = text.strip().lower().replace(' ', '')
    if re.fullmatch(r'\d+', text):
        return int(text) * 60
    if m := re.fullmatch(r'(\d+):(\d{1,2})', text):
        return int(m[1]) * 60 + int(m[2])
    parts = re.findall(r'(\d+(?:\.\d+)?)([hms])', text)
    if not parts or ''.join(n + u for n, u in parts) != text:
        return None
    return int(sum(float(n) * {'h': 3600, 'm': 60, 's': 1}[u] for n, u in parts))


def square_texture(pixbuf, size=256):
    w, h = pixbuf.get_width(), pixbuf.get_height()
    side = min(w, h)
    pixbuf = pixbuf.new_subpixbuf((w - side) // 2, (h - side) // 2, side, side)
    if side > size:
        pixbuf = pixbuf.scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)
    ok, png = pixbuf.save_to_bufferv('png', [], [])
    return Gdk.Texture.new_from_bytes(GLib.Bytes.new(png))


def glyph_button(glyph, callback, css='ctl'):
    button = Gtk.Button(label=glyph)
    button.add_css_class(css)
    button.set_focusable(False)
    button.connect('clicked', lambda *_: callback())
    return button


def fit(widget, text, markup=None):
    if markup is None:
        widget.set_text(text)
    else:
        widget.set_markup(markup)
    widget.set_width_chars(min(len(text), widget.get_max_width_chars()))


def label(css, ellipsize=False, xalign=0.0):
    widget = Gtk.Label(xalign=xalign)
    widget.add_css_class(css)
    if ellipsize:
        widget.set_ellipsize(Pango.EllipsizeMode.END)
        widget.set_width_chars(1)
    return widget


class Equalizer(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.set_content_width(16)
        self.set_content_height(12)
        self.set_valign(Gtk.Align.CENTER)
        self.playing = False
        self.timer = 0
        self.set_draw_func(self.draw)

    def set_playing(self, playing):
        changed, self.playing = playing != self.playing, playing
        if playing and not self.timer:
            self.timer = GLib.timeout_add(66, self.redraw)
        if changed:
            self.queue_draw()

    def redraw(self):
        self.queue_draw()
        if not self.playing or not self.get_mapped():
            self.timer = 0
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    def draw(self, _area, cr, width, height):
        cr.set_source_rgb(0xa6 / 255, 0xe3 / 255, 0xa1 / 255)
        t = time.monotonic()
        bar = width / 4
        for i in range(4):
            if self.playing:
                level = 0.35 + 0.65 * abs(math.sin(t * (2.1 + i * 0.9) + i * 1.7))
            else:
                level = 0.2
            h = max(2, height * level)
            cr.rectangle(i * bar + 0.5, height - h, bar - 1.5, h)
        cr.fill()


class Island(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='io.github.sr44.Island',
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.player = None
        self.paused_at = None
        self.art_url = None
        self.art_cache = {}
        self.timer_end = None
        self.timer_left = None
        self.timer_total = 0
        self.flash_until = 0
        self.notice_until = 0
        self.rec = None
        self.expanded = False
        self.pinned = False
        self.layout_key = None
        self.hover_source = 0
        self.dbus_monitor = None

    def do_shutdown(self):
        try:
            os.remove(TIMER)
        except OSError:
            pass
        Gtk.Application.do_shutdown(self)

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        remote = cmdline.get_is_remote()
        if args and args[0] in ('-h', '--help'):
            cmdline.print_literal(__doc__.strip() + '\n')
            return 0
        if args and args[0] == 'status':
            if remote:
                text = self.status(args[1:])
                if text:
                    cmdline.print_literal(text + '\n')
            return 0
        if not args:
            if remote:
                self.quit()
            else:
                self.start()
            return 0
        if args == ['toggle']:
            if remote:
                self.pinned = not (self.pinned and self.expanded)
                self.expand(self.pinned)
            return 0
        if args[0] == 'timer' and len(args) > 1:
            self.start()
            if not self.timer_command(' '.join(args[1:])):
                cmdline.printerr_literal(f'island: cannot read duration {args[1]!r}\n')
                return 1
            return 0
        cmdline.printerr_literal(f'island: unknown command {" ".join(args)!r} (see --help)\n')
        return 2

    def status(self, what):
        if what == ['timer-raw']:
            left = self.timer_remaining()
            if left is None:
                return ''
            return f'{left:.1f} {self.timer_total} {int(self.timer_left is not None)}'
        parts = {}
        left = self.timer_remaining()
        if left is not None:
            parts['timer'] = ('paused ' if self.timer_left is not None else '') + clock(left)
        if not what or what[0] != 'timer':
            if self.rec:
                parts['rec'] = 'recording ' + clock(time.time() - self.rec[0])
            if self.player and self.player_status() == 'playing':
                parts['media'] = f'{self.player.get_artist() or ""} - {self.player.get_title() or ""}'
        if what:
            return parts.get(what[0], '')
        return '\n'.join(f'{k}: {v}' for k, v in parts.items())

    def start(self):
        if self.win:
            return
        self.hold()
        css = Gtk.CssProvider()
        css.load_from_path(os.path.join(HERE, 'style.css'))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)

        win = self.win = Gtk.Window(application=self)
        win.add_css_class('island-window')
        LayerShell.init_for_window(win)
        LayerShell.set_namespace(win, 'island')
        LayerShell.set_layer(win, LayerShell.Layer.TOP)
        LayerShell.set_anchor(win, LayerShell.Edge.TOP, True)
        LayerShell.set_exclusive_zone(win, -1)
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)

        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.root.add_css_class('island')
        self.root.set_halign(Gtk.Align.CENTER)
        win.set_child(self.root)

        self.root.append(self.build_compact())
        self.card = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
                                 transition_duration=220)
        self.card.set_child(self.build_card())
        self.card.set_visible(False)
        self.card.connect('notify::child-revealed', self.on_card_revealed)
        self.root.append(self.card)

        hover = Gtk.EventControllerMotion()
        hover.connect('enter', lambda *_: self.hover(True))
        hover.connect('leave', lambda *_: self.hover(False))
        self.root.add_controller(hover)
        click = Gtk.GestureClick(button=0)
        click.connect('released', self.on_compact_click)
        self.compact.add_controller(click)

        self.setup_players()
        self.setup_notifications()
        GLib.timeout_add(500, self.tick)
        self.tick()

    def build_compact(self):
        box = self.compact = Gtk.Box(spacing=10)
        box.add_css_class('compact')
        box.set_halign(Gtk.Align.CENTER)

        self.c_notice = Gtk.Box(spacing=8)
        self.c_notice_icon = Gtk.Image(pixel_size=16)
        self.c_notice_text = label('c-text', ellipsize=True)
        self.c_notice_text.set_max_width_chars(48)
        self.c_notice.append(self.c_notice_icon)
        self.c_notice.append(self.c_notice_text)

        self.c_media = Gtk.Box(spacing=8)
        self.c_art = Gtk.Image(pixel_size=16, overflow=Gtk.Overflow.HIDDEN, valign=Gtk.Align.CENTER)
        self.c_art.add_css_class('c-art')
        self.c_title = label('c-text', ellipsize=True)
        self.c_title.set_max_width_chars(32)
        self.c_eq = Equalizer()
        for w in (self.c_art, self.c_title, self.c_eq):
            self.c_media.append(w)

        self.c_clock = label('c-clock')
        self.c_timer = label('c-timer')
        self.c_rec = label('c-rec')

        for w in (self.c_clock, self.c_notice, self.c_media, self.c_timer, self.c_rec):
            box.append(w)
        return box

    def build_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class('sheet')

        self.m_box = Gtk.Box(spacing=14)
        self.m_art = Gtk.Image(pixel_size=76, overflow=Gtk.Overflow.HIDDEN, valign=Gtk.Align.CENTER)
        self.m_art.add_css_class('art')
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
        self.m_title = label('title', ellipsize=True)
        self.m_artist = label('artist', ellipsize=True)
        self.m_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 1)
        self.m_scale.set_draw_value(False)
        self.m_scale.set_focusable(False)
        self.m_scale.add_css_class('progress')
        self.m_scale.connect('change-value', self.on_seek)
        times = Gtk.Box()
        self.m_pos = label('time')
        self.m_len = label('time', xalign=1.0)
        self.m_len.set_hexpand(True)
        times.append(self.m_pos)
        times.append(self.m_len)
        controls = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        self.m_play = glyph_button('󰐊', lambda: self.player and self.player.play_pause(), 'ctl-main')
        controls.append(glyph_button('󰒮', lambda: self.player and self.player.previous()))
        controls.append(self.m_play)
        controls.append(glyph_button('󰒭', lambda: self.player and self.player.next()))
        for w in (self.m_title, self.m_artist, self.m_scale, times, controls):
            info.append(w)
        self.m_box.append(self.m_art)
        self.m_box.append(info)

        self.t_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.t_box.add_css_class('section')
        row = Gtk.Box(spacing=6)
        self.t_label = label('big')
        self.t_label.set_hexpand(True)
        self.t_pause = glyph_button('󰏤', lambda: self.timer_command('pause'))
        row.append(self.t_label)
        row.append(self.t_pause)
        row.append(glyph_button('+5', lambda: self.timer_command('+5m'), 'ctl-text'))
        row.append(glyph_button('󰓛', lambda: self.timer_command('stop')))
        self.t_bar = Gtk.ProgressBar()
        self.t_bar.add_css_class('timer-bar')
        self.t_box.append(row)
        self.t_box.append(self.t_bar)

        self.r_box = Gtk.Box(spacing=6)
        self.r_box.add_css_class('section')
        self.r_label = label('big rec')
        self.r_label.set_hexpand(True)
        self.r_box.append(self.r_label)
        self.r_box.append(glyph_button('󰓛  Stop', self.stop_recording, 'ctl-text'))

        for w in (self.m_box, self.t_box, self.r_box):
            card.append(w)
        return card

    def hover(self, inside):
        if self.hover_source:
            GLib.source_remove(self.hover_source)
        delay = EXPAND_DELAY if inside else COLLAPSE_DELAY
        self.hover_source = GLib.timeout_add(delay, self.on_hover_settled, inside)

    def on_hover_settled(self, inside):
        self.hover_source = 0
        if inside:
            self.expand(True)
        elif not self.pinned:
            self.expand(False)
        return GLib.SOURCE_REMOVE

    def on_compact_click(self, gesture, n, x, y):
        if gesture.get_current_button() == 2 and self.rec:
            self.stop_recording()
            return
        self.pinned = not (self.pinned and self.expanded)
        self.expand(self.pinned)

    def expand(self, on):
        if on and time.monotonic() < self.notice_until:
            self.notice_until = 0
            self.refresh()
        if on == self.expanded:
            return
        self.expanded = on
        if not on:
            self.pinned = False
        if on:
            self.card.set_visible(True)
            self.root.add_css_class('expanded')
        else:
            self.root.remove_css_class('expanded')
        self.card.set_reveal_child(on)
        self.refresh()

    def on_card_revealed(self, revealer, _pspec):
        if not revealer.get_child_revealed() and not self.expanded:
            revealer.set_visible(False)
            self.win.set_default_size(1, 1)

    def setup_players(self):
        self.manager = Playerctl.PlayerManager()
        self.manager.connect('name-appeared', lambda _m, name: self.manage(name))
        self.manager.connect('player-vanished', self.on_player_vanished)
        for name in self.manager.props.player_names:
            self.manage(name)

    def manage(self, name):
        player = Playerctl.Player.new_from_name(name)
        player.connect('playback-status', self.on_status)
        player.connect('metadata', lambda p, _md: p is self.player and self.refresh())
        self.manager.manage_player(player)
        if self.player is None or player.props.playback_status == Playerctl.PlaybackStatus.PLAYING:
            self.player = player
        self.refresh()

    def on_player_vanished(self, _manager, player):
        if player is self.player:
            players = self.manager.props.players
            playing = [p for p in players if p.props.playback_status == Playerctl.PlaybackStatus.PLAYING]
            self.player = (playing or players or [None])[0]
            self.paused_at = time.monotonic()
        self.refresh()

    def on_status(self, player, status):
        if status == Playerctl.PlaybackStatus.PLAYING:
            self.player = player
            self.paused_at = None
        elif player is self.player:
            self.paused_at = time.monotonic()
        self.refresh()

    def player_status(self):
        try:
            return self.player.props.playback_status.value_nick.lower()
        except Exception:
            return 'stopped'

    def metadata(self):
        try:
            return self.player.props.metadata.unpack() if self.player else {}
        except Exception:
            return {}

    def position(self):
        try:
            return self.player.get_position() / 1e6
        except Exception:
            return 0.0

    def on_seek(self, _scale, _scroll, value):
        if self.player:
            try:
                self.player.set_position(int(value * 1e6))
            except GLib.Error:
                pass
        return False

    def load_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        if not url:
            self.set_art(None)
        elif url in self.art_cache:
            self.set_art(self.art_cache[url])
        elif url.startswith('file://'):
            try:
                texture = square_texture(GdkPixbuf.Pixbuf.new_from_file(GLib.filename_from_uri(url)[0]))
            except GLib.Error:
                texture = None
            self.art_cache[url] = texture
            self.set_art(texture)
        else:
            self.set_art(None)
            threading.Thread(target=self.fetch_art, args=(url,), daemon=True).start()

    def fetch_art(self, url):
        try:
            with urllib.request.urlopen(url, timeout=6) as resp:
                data = resp.read(8 << 20)
        except Exception:
            return
        GLib.idle_add(self.on_art_fetched, url, data)

    def on_art_fetched(self, url, data):
        try:
            stream = Gio.MemoryInputStream.new_from_bytes(GLib.Bytes.new(data))
            texture = square_texture(GdkPixbuf.Pixbuf.new_from_stream(stream, None))
        except GLib.Error:
            texture = None
        self.art_cache[url] = texture
        if url == self.art_url:
            self.set_art(texture)
        return GLib.SOURCE_REMOVE

    def set_art(self, texture):
        for image in (self.c_art, self.m_art):
            image.set_from_paintable(texture)
        self.c_art.set_visible(texture is not None)
        self.m_art.set_visible(texture is not None)

    def timer_remaining(self):
        if self.timer_left is not None:
            return self.timer_left
        if self.timer_end is not None:
            return max(0, self.timer_end - time.monotonic())
        return None

    def timer_command(self, cmd):
        cmd = cmd.strip()
        left = self.timer_remaining()
        if cmd == 'stop':
            self.timer_end = self.timer_left = None
        elif cmd == 'pause':
            if self.timer_left is not None:
                self.timer_end = time.monotonic() + self.timer_left
                self.timer_left = None
            elif self.timer_end is not None:
                self.timer_left = left
        elif cmd.startswith('+'):
            extra = parse_duration(cmd[1:])
            if extra is None:
                return False
            if left is None:
                return self.timer_command(cmd[1:])
            self.timer_total += extra
            if self.timer_left is not None:
                self.timer_left += extra
            else:
                self.timer_end += extra
        else:
            seconds = parse_duration(cmd)
            if not seconds:
                return False
            self.timer_total = seconds
            self.timer_left = None
            self.timer_end = time.monotonic() + seconds
        self.save_timer()
        self.refresh()
        return True

    def save_timer(self):
        left = self.timer_remaining()
        try:
            if left is None:
                os.remove(TIMER)
                return
            os.makedirs(os.path.dirname(TIMER), exist_ok=True)
            with open(TIMER + '.tmp', 'w') as f:
                f.write(f'{left:.2f} {time.time():.2f} {self.timer_total} {int(self.timer_left is not None)}\n')
            os.replace(TIMER + '.tmp', TIMER)
        except OSError:
            pass

    def timer_done(self):
        minutes = self.timer_total / 60
        what = f'{minutes:g} min' if minutes >= 1 else f'{self.timer_total} s'
        self.timer_end = self.timer_left = None
        self.save_timer()
        self.flash_until = time.monotonic() + 6
        subprocess.Popen(['notify-send', '-a', 'island', '-u', 'critical', 'Timer', f'{what} is up'])
        if os.path.exists(SOUND):
            subprocess.Popen(['pw-play', SOUND], stderr=subprocess.DEVNULL)

    def read_recording(self):
        try:
            with open(REC) as f:
                pid, kind, start = f.read().split()[:3]
        except (OSError, ValueError):
            return None
        if not os.path.exists(f'/proc/{pid}'):
            return None
        return int(start), kind

    def stop_recording(self):
        subprocess.Popen([os.path.join(HUB, 'capture'), 'stop'])

    def setup_notifications(self):
        try:
            address = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION, None)
            conn = Gio.DBusConnection.new_for_address_sync(
                address,
                Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
                | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
                None, None)
            conn.call_sync(
                'org.freedesktop.DBus', '/org/freedesktop/DBus',
                'org.freedesktop.DBus.Monitoring', 'BecomeMonitor',
                GLib.Variant('(asu)', ([
                    "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"
                ], 0)),
                None, Gio.DBusCallFlags.NONE, -1, None)
        except GLib.Error as e:
            print(f'island: notifications unavailable: {e.message}', file=sys.stderr)
            return
        conn.add_filter(self.on_dbus_message)
        self.dbus_monitor = conn

    def on_dbus_message(self, _conn, message, _incoming):
        if message.get_member() == 'Notify':
            try:
                args = message.get_body().unpack()
            except Exception:
                return None
            GLib.idle_add(self.on_notification, *args[:5], args[6])
        return None

    def on_notification(self, app, _replaces, icon, summary, body, hints):
        if app in ('island', 'sysmon') or self.dnd():
            return GLib.SOURCE_REMOVE
        image = hints.get('image-path') or icon or ''
        if image.startswith('file://'):
            image = GLib.filename_from_uri(image)[0]
        if image.startswith('/') and os.path.exists(image):
            self.c_notice_icon.set_from_file(image)
        else:
            self.c_notice_icon.set_from_icon_name(image or 'dialog-information-symbolic')
        title = summary or app
        text = re.sub(r'<[^>]+>', '', body or '').replace('\n', ' ').strip()
        markup = f'<b>{GLib.markup_escape_text(title)}</b>'
        if text:
            markup += f'  {GLib.markup_escape_text(text)}'
        fit(self.c_notice_text, f'{title}  {text}'.strip(), markup)
        if not self.expanded:
            self.notice_until = time.monotonic() + NOTIFY_SECONDS
        self.refresh()
        return GLib.SOURCE_REMOVE

    @staticmethod
    def dnd():
        try:
            out = subprocess.run(['swaync-client', '-D', '-sw'], capture_output=True,
                                 text=True, timeout=1).stdout
        except (OSError, subprocess.TimeoutExpired):
            return False
        return out.strip() == 'true'

    def tick(self):
        rec = self.read_recording()
        if rec != self.rec:
            self.rec = rec
        left = self.timer_remaining()
        if left is not None and left <= 0 and self.timer_left is None:
            self.timer_done()
        self.refresh()
        return GLib.SOURCE_CONTINUE

    def refresh(self):
        if not self.win:
            return
        now = time.monotonic()
        status = self.player_status() if self.player else 'stopped'
        show_media = self.player is not None and (
            status == 'playing'
            or (status == 'paused' and (self.expanded or (self.paused_at and now - self.paused_at < PAUSED_LINGER))))
        left = self.timer_remaining()
        flashing = now < self.flash_until
        notice = now < self.notice_until

        self.c_clock.set_text(time.strftime('%H:%M:%S'))
        self.c_notice.set_visible(notice)
        self.c_media.set_visible(show_media and not notice)
        self.c_timer.set_visible((left is not None or flashing) and not notice)
        self.c_rec.set_visible(self.rec is not None and not notice)

        md = self.metadata() if show_media else {}
        if show_media:
            title = self.player.get_title() or md.get('xesam:url', '') or 'Unknown'
            artist = self.player.get_artist() or ''
            fit(self.c_title, f'{title} · {artist}' if artist else title)
            self.c_eq.set_playing(status == 'playing')
            self.load_art(md.get('mpris:artUrl', ''))
            self.m_title.set_text(title)
            self.m_artist.set_text(artist or self.player.props.player_name)
            self.m_play.set_label('󰏤' if status == 'playing' else '󰐊')
            length = md.get('mpris:length', 0) / 1e6
            pos = self.position()
            self.m_scale.set_visible(length > 0)
            if length > 0 and not self.m_scale.get_state_flags() & Gtk.StateFlags.ACTIVE:
                self.m_scale.set_range(0, length)
                self.m_scale.set_value(min(pos, length))
            self.m_pos.set_text(clock(pos) if length > 0 else '')
            self.m_len.set_text(clock(length) if length > 0 else '')
        else:
            self.c_eq.set_playing(False)

        if flashing:
            self.c_timer.set_text('󰔛  done')
        elif left is not None:
            paused = self.timer_left is not None
            self.c_timer.set_text(('󰏤 ' if paused else '󰔛 ') + clock(left))
            self.t_label.set_text(clock(left))
            self.t_pause.set_label('󰐊' if paused else '󰏤')
            self.t_bar.set_fraction(1 - left / self.timer_total if self.timer_total else 0)
        self.c_timer.set_css_classes(['c-timer'] + (['flash'] if flashing else []))

        if self.rec:
            elapsed = clock(time.time() - self.rec[0])
            kind = 'GIF' if self.rec[1] == 'gif' else 'REC'
            self.c_rec.set_text(f'● {elapsed}')
            self.r_label.set_text(f'● {kind}  {elapsed}')

        self.m_box.set_visible(show_media)
        self.t_box.set_visible(left is not None)
        self.r_box.set_visible(self.rec is not None)

        active = notice or show_media or left is not None or flashing or self.rec is not None
        if not active and self.expanded:
            self.expand(False)
            return
        self.win.set_visible(active)

        key = (notice, show_media, left is not None, flashing, self.rec is not None,
               self.c_title.get_width_chars(), self.c_notice_text.get_width_chars(), self.expanded)
        if key != self.layout_key:
            self.layout_key = key
            self.win.set_default_size(1, 1)


if __name__ == '__main__':
    app = Island()
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: app.quit())
    sys.exit(app.run(sys.argv))
