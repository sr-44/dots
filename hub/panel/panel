        self.entry.connect('activate', lambda e: (self.command(e.get_text()), e.set_text('')))

        self.island = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.island_handler = self.island.connect('state-set', self.on_island)
        island_row = box(glyph('󰍹', 'section-glyph'),
                         box(label('Island', 'app-name'),
                             label('Music, timer and recording above the bar', 'dim small', ellipsize=True),
                             vertical=True, hexpand=True),
                         self.island, spacing=12, css='card')
        Gio.bus_watch_name(Gio.BusType.SESSION, ISLAND_BUS, Gio.BusNameWatcherFlags.NONE,
                           lambda *_: self.set_island(True), lambda *_: self.set_island(False))

        content = box(page_header('Timer'), overlay, self.controls,
                      label('START', 'heading'), chips, self.entry,
                      island_row, vertical=True, spacing=12, css='page')
        self.widget = scrolled(content)
        self.tick_source = 0

    def set_island(self, running):
        self.island.handler_block(self.island_handler)
        self.island.set_active(running)
        self.island.set_state(running)
        self.island.handler_unblock(self.island_handler)

    def on_island(self, _switch, on):
        spawn(ISLAND)
        return False

    def command(self, arg):
        if arg.strip():
            spawn(ISLAND, 'timer', arg.strip())
            GLib.timeout_add(400, lambda: self.tick() and False)

    def read(self):
        try:
            with open(os.path.join(RUN, 'timer')) as f:
                left, written, total, paused = f.read().split()
        except (OSError, ValueError):
            return None
        left, total, paused = float(left), float(total), paused == '1'
        if not paused:
            left -= time.time() - float(written)
        return max(0.0, left), total, paused

    def shown(self):
        super().shown()
        self.tick()
        if not self.tick_source:
            self.tick_source = GLib.timeout_add(250, self.tick)

    def tick(self):
        t = self.read()
        if t and t[0] > 0:
            left, total, paused = t
            self.time.set_text(clock(left))
            self.state.set_text('Paused' if paused else f'of {clock(total)}')
            self.ring.fraction = left / total if total else 0
            self.ring.paused = paused
            self.pause.get_child().set_text('󰐊' if paused else '󰏤')
        else:
            self.time.set_text('0:00')
            self.state.set_text('Ready')
            self.ring.fraction = 0
        self.controls.set_sensitive(bool(t))
        self.ring.queue_draw()
        if not self.visible:
            self.tick_source = 0
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE


class Hub(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='io.github.sr44.Hub',
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.panel = None
        self.current = None

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        if args and args[0] in ('-h', '--help'):
            cmdline.print_literal(__doc__.strip() + '\n')
            return 0
        if args == ['--quit']:
            self.quit()
            return 0
        names = [p[0] for p in PAGES]
        if args and args[0] not in names + ['--daemon']:
            cmdline.printerr_literal(f'panel: unknown page {args[0]!r} (see --help)\n')
            return 2
        self.setup()
        if args == ['--daemon']:
            return 0
        page = args[0] if args else None
        if self.is_open() and (page is None or page == self.current):
            self.hide()
        else:
            self.show(page or self.current or names[0])
        return 0

    def setup(self):
        if self.panel:
            return
        self.hold()
        css = Gtk.CssProvider()
        css.load_from_path(os.path.join(HERE, 'style.css'))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)

        self.backdrop = Gtk.Window(application=self, css_classes=['hub-backdrop'])
        LayerShell.init_for_window(self.backdrop)
        LayerShell.set_namespace(self.backdrop, 'hub-backdrop')
        LayerShell.set_layer(self.backdrop, LayerShell.Layer.OVERLAY)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(self.backdrop, edge, True)
        LayerShell.set_exclusive_zone(self.backdrop, -1)
        click = Gtk.GestureClick(button=0)
        click.connect('pressed', lambda *_: self.hide())
        self.backdrop.add_controller(click)

        panel = self.panel = Gtk.Window(application=self, css_classes=['hub-window'])
        LayerShell.init_for_window(panel)
        LayerShell.set_namespace(panel, 'hub')
        LayerShell.set_layer(panel, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(panel, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(panel, LayerShell.Edge.LEFT, True)
        LayerShell.set_margin(panel, LayerShell.Edge.TOP, 8)
        LayerShell.set_margin(panel, LayerShell.Edge.LEFT, 8)
        LayerShell.set_keyboard_mode(panel, LayerShell.KeyboardMode.EXCLUSIVE)
        panel.set_default_size(WIDTH, HEIGHT)

        self.pages = {}
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                               transition_duration=220, vexpand=True)
        self.tabs = {}
        tabbar = box(spacing=4, css='tabs', homogeneous=True)
        group = None
        for name, g, title in PAGES:
            page = {'sound': SoundPage, 'clipboard': ClipboardPage, 'capture': CapturePage,
                    'system': SystemPage, 'timer': TimerPage}[name](self)
            self.pages[name] = page
            self.stack.add_named(page.widget, name)
            tab = Gtk.ToggleButton(css_classes=['tab'], focusable=False, tooltip_text=title)
            tab.set_child(box(glyph(g, 'tab-glyph'), label(title, 'tab-text', xalign=0.5),
                              vertical=True, spacing=2))
            if group:
                tab.set_group(group)
            group = group or tab
            tab.connect('toggled', lambda t, n=name: t.get_active() and self.switch(n))
            self.tabs[name] = tab
            tabbar.append(tab)

        root = box(tabbar, self.stack, vertical=True, spacing=0, css='hub')
        root.set_size_request(WIDTH, HEIGHT)
        panel.set_child(root)

        keys = Gtk.EventControllerKey()
        keys.connect('key-pressed', self.on_key)
        panel.add_controller(keys)

    def on_key(self, _ctl, keyval, _code, state):
        names = [p[0] for p in PAGES]
        if keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        if state & Gdk.ModifierType.CONTROL_MASK and keyval in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            step = -1 if keyval == Gdk.KEY_ISO_Left_Tab or state & Gdk.ModifierType.SHIFT_MASK else 1
            self.show(names[(names.index(self.current) + step) % len(names)])
            return True
        if state & Gdk.ModifierType.ALT_MASK and Gdk.KEY_1 <= keyval <= Gdk.KEY_5:
            self.show(names[keyval - Gdk.KEY_1])
            return True
        return False

    def is_open(self):
        return bool(self.panel and self.panel.get_visible())

    def switch(self, name):
        if name == self.current and self.is_open():
            return
        if self.current and self.current != name:
            self.pages[self.current].hidden()
        self.current = name
        self.stack.set_visible_child_name(name)
        if self.is_open():
            self.pages[name].shown()

    def show(self, name):
        if not self.is_open():
            self.backdrop.set_visible(True)
            self.panel.set_visible(True)
            self.panel.add_css_class('opening')
            GLib.timeout_add(30, lambda: self.panel.remove_css_class('opening') or False)
            if self.current == name:
                self.pages[name].shown()
        self.tabs[name].set_active(True)
        self.switch(name)

    def hide(self):
        if not self.is_open():
            return
        self.pages[self.current].hidden()
        self.panel.set_visible(False)
        self.backdrop.set_visible(False)


if __name__ == '__main__':
    import signal
    app = Hub()
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: app.quit())
    sys.exit(app.run(sys.argv))
