def load_sysmon():
    sys.dont_write_bytecode = True
    path = os.path.join(HUB, 'sysmon')
    loader = importlib.machinery.SourceFileLoader('sysmon', path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader('sysmon', loader))
    loader.exec_module(module)
    return module


sysmon = load_sysmon()


def spawn(*cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def output(*cmd, data=None, timeout=3):
    try:
        return subprocess.run(cmd, input=data, capture_output=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return b''


def pactl_json(*what):
    try:
        return json.loads(output('pactl', '-f', 'json', 'list', *what) or b'[]')
    except ValueError:
        return []


def clock(seconds):
    seconds = max(0, int(seconds + 0.5))
    h, rest = divmod(seconds, 3600)
    return f'{h}:{rest // 60:02}:{rest % 60:02}' if h else f'{rest // 60}:{rest % 60:02}'


def square_texture(pixbuf, size=128):
    w, h = pixbuf.get_width(), pixbuf.get_height()
    side = min(w, h)
    pixbuf = pixbuf.new_subpixbuf((w - side) // 2, (h - side) // 2, side, side)
    if side > size:
        pixbuf = pixbuf.scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)
    _ok, png = pixbuf.save_to_bufferv('png', [], [])
    return Gdk.Texture.new_from_bytes(GLib.Bytes.new(png))


def label(text='', css=None, xalign=0.0, ellipsize=False, lines=1, **props):
    widget = Gtk.Label(label=text, xalign=xalign, **props)
    for c in (css or '').split():
        widget.add_css_class(c)
    if ellipsize:
        widget.set_ellipsize(Pango.EllipsizeMode.END)
        widget.set_width_chars(1)
        if lines > 1:
            widget.set_wrap(True)
            widget.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            widget.set_lines(lines)
    return widget


def glyph(text, css=''):
    return label(text, ('glyph ' + css).strip(), xalign=0.5)


def button(child, callback, css='flat', tooltip=None):
    btn = Gtk.Button()
    btn.set_child(glyph(child) if isinstance(child, str) else child)
    for c in css.split():
        btn.add_css_class(c)
    btn.set_focusable(False)
    if tooltip:
        btn.set_tooltip_text(tooltip)
    btn.connect('clicked', lambda *_: callback())
    return btn


def box(*children, vertical=False, spacing=0, css=None, **props):
    widget = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL,
                     spacing=spacing, **props)
    for c in (css or '').split():
        widget.add_css_class(c)
    for child in children:
        if child is not None:
            widget.append(child)
    return widget


def clear(container):
    while child := container.get_first_child():
        container.remove(child)


def page_header(title, *extra):
    return box(label(title, 'page-title'), box(hexpand=True), *extra, css='page-header', spacing=8)


def scrolled(child):
    sw = Gtk.ScrolledWindow(vexpand=True)
    sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    sw.set_child(child)
    return sw


class Volume(Gtk.Box):
    def __init__(self, on_volume, on_mute, glyphs=('󰕾', '󰖁')):
        super().__init__(spacing=10, css_classes=['volume'])
        self.on_volume = on_volume
        self.glyphs = glyphs
        self.mute = button(glyphs[0], on_mute, 'round mute', 'Mute')
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, MAX_VOLUME, 1)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.scale.set_focusable(False)
        self.scale.connect('value-changed', self.on_changed)
        self.readout = label('', 'readout', xalign=1.0)
        self.readout.set_width_chars(4)
        self.updating = False
        self.touched = 0.0
        self.pending = None
        for w in (self.mute, self.scale, self.readout):
            self.append(w)

    def set(self, volume, muted):
        self.mute.get_child().set_text(self.glyphs[1] if muted else self.glyphs[0])
        if muted:
            self.add_css_class('muted')
        else:
            self.remove_css_class('muted')
        if time.monotonic() - self.touched < 0.8:
            return
        self.updating = True
        self.scale.set_value(volume)
        self.updating = False
        self.readout.set_text(f'{volume}%')
        self.scale.set_css_classes(['boost'] if volume > 100 else [])

    def on_changed(self, scale):
        value = round(scale.get_value())
        self.readout.set_text(f'{value}%')
        scale.set_css_classes(['boost'] if value > 100 else [])
        if self.updating:
            return
        self.touched = time.monotonic()
        if self.pending is None:
            GLib.timeout_add(40, self.flush)
        self.pending = value

    def flush(self):
        self.on_volume(self.pending)
        self.pending = None
        return GLib.SOURCE_REMOVE


class Picker(Gtk.MenuButton):
    def __init__(self, on_pick, compact=False):
        super().__init__(css_classes=['picker'])
        self.on_pick = on_pick
        self.text = label('', 'picker-label', ellipsize=True)
        self.text.set_max_width_chars(22)
        if compact:
            self.set_child(glyph('󰓃'))
            self.set_tooltip_text('Output')
        else:
            self.set_child(box(self.text, glyph('󰅀', 'chevron'), spacing=6))
        self.list = box(vertical=True, spacing=2, css='picker-list')
        popover = Gtk.Popover(css_classes=['hub-popover'], has_arrow=False)
        popover.set_child(self.list)
        self.set_popover(popover)

    def set_items(self, items, current):
        clear(self.list)
        for name, title in items:
            mark = glyph('󰄬' if name == current else '', 'check')
            row = button(box(mark, label(title, ellipsize=True, hexpand=True), spacing=8),
                         lambda n=name: self.pick(n), 'menu-row')
            self.list.append(row)
            if name == current:
                self.text.set_text(title)

    def pick(self, name):
        self.get_popover().popdown()
        self.on_pick(name)


class Page:
    name = ''

    def __init__(self, app):
        self.app = app
        self.visible = False

    def shown(self):
        self.visible = True

    def hidden(self):
        self.visible = False


def device_title(dev):
    props = dev.get('properties', {})
    desc = dev.get('description') or dev.get('name', '?')
    nick = props.get('node.nick')
    card = props.get('device.description')
    if nick and card and desc.startswith(card):
        return nick
    return desc


def percent(dev):
    try:
        return int(next(iter(dev['volume'].values()))['value_percent'].rstrip('%'))
    except (KeyError, StopIteration, ValueError, AttributeError):
        return 0


class SoundPage(Page):
    name = 'sound'

    def __init__(self, app):
        super().__init__(app)
        self.sinks = []
        self.streams = {}
        self.subscribe = None
        self.refresh_source = 0

        self.out_picker = Picker(lambda n: self.set_default('sink', n))
        self.out = Volume(lambda v: spawn('pactl', 'set-sink-volume', '@DEFAULT_SINK@', f'{v}%'),
                          lambda: self.toggle_mute('sink', '@DEFAULT_SINK@'))
        self.in_picker = Picker(lambda n: self.set_default('source', n))
        self.mic = Volume(lambda v: spawn('pactl', 'set-source-volume', '@DEFAULT_SOURCE@', f'{v}%'),
                          lambda: self.toggle_mute('source', '@DEFAULT_SOURCE@'), ('󰍬', '󰍭'))

        self.apps = box(vertical=True, spacing=8)
        self.empty = box(glyph('󰝟', 'empty-glyph'), label('No apps are playing sound', 'dim', xalign=0.5),
                         vertical=True, spacing=6, css='empty')

        content = box(
            page_header('Sound'),
            box(box(glyph('󰓃', 'section-glyph'), label('Output', 'section'), box(hexpand=True),
                    self.out_picker, spacing=8),
                self.out, vertical=True, spacing=10, css='card'),
            box(box(glyph('󰍬', 'section-glyph'), label('Microphone', 'section'), box(hexpand=True),
                    self.in_picker, spacing=8),
                self.mic, vertical=True, spacing=10, css='card'),
            label('APPS', 'heading'),
            self.apps,
            self.empty,
            vertical=True, spacing=12, css='page')
        self.widget = scrolled(content)

    def shown(self):
        super().shown()
        self.refresh()
        self.start_subscribe()

    def hidden(self):
        super().hidden()
        if self.subscribe:
            self.subscribe.force_exit()
            self.subscribe = None

    def start_subscribe(self):
        if self.subscribe:
            return
        try:
            self.subscribe = Gio.Subprocess.new(['pactl', 'subscribe'], Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error:
            return
        stream = Gio.DataInputStream.new(self.subscribe.get_stdout_pipe())
        self.read_event(stream, self.subscribe)

    def read_event(self, stream, proc):
        def done(src, res):
            try:
                line, _ = src.read_line_finish_utf8(res)
            except GLib.Error:
                return
            if line is None or proc is not self.subscribe:
                return
            if "'remove'" in line or "'new'" in line or "'change'" in line:
                self.queue_refresh()
            self.read_event(stream, proc)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, done)

    def queue_refresh(self):
        if not self.refresh_source:
            self.refresh_source = GLib.timeout_add(120, self.refresh)

    def refresh(self):
        self.refresh_source = 0
        self.sinks = pactl_json('sinks')
        sources = [s for s in pactl_json('sources')
                   if s.get('properties', {}).get('device.class') != 'monitor']
        default_sink = output('pactl', 'get-default-sink').decode().strip()
        default_source = output('pactl', 'get-default-source').decode().strip()

        for dev in self.sinks:
            if dev['name'] == default_sink:
                self.out.set(percent(dev), dev.get('mute', False))
        for dev in sources:
            if dev['name'] == default_source:
                self.mic.set(percent(dev), dev.get('mute', False))
        self.out_picker.set_items([(d['name'], device_title(d)) for d in self.sinks], default_sink)
        self.in_picker.set_items([(d['name'], device_title(d)) for d in sources], default_source)

        streams = pactl_json('sink-inputs')
        indexes = [s['index'] for s in streams]
        if sorted(indexes) != sorted(self.streams):
            clear(self.apps)
            self.streams = {i: self.app_row(i) for i in indexes}
            for i in indexes:
                self.apps.append(self.streams[i]['widget'])
        for s in streams:
            row = self.streams[s['index']]
            props = s.get('properties', {})
            name = props.get('application.name') or props.get('application.process.binary') or 'Unknown'
            detail = props.get('media.name', '')
            row['name'].set_text(name)
            row['detail'].set_text(detail if detail and detail != name else '')
            row['detail'].set_visible(bool(row['detail'].get_text()))
            row['icon'].set_from_icon_name(props.get('application.icon_name')
                                           or props.get('application.process.binary') or 'audio-x-generic')
            row['volume'].set(percent(s), s.get('mute', False))
            sink_name = next((d['name'] for d in self.sinks if d['index'] == s.get('sink')), '')
            row['picker'].set_items([(d['name'], device_title(d)) for d in self.sinks], sink_name)
        self.empty.set_visible(not streams)
        return GLib.SOURCE_REMOVE

    def app_row(self, index):
        icon = Gtk.Image(pixel_size=34, css_classes=['app-icon'])
        name = label('', 'app-name', ellipsize=True)
        detail = label('', 'dim small', ellipsize=True)
        picker = Picker(lambda n: (spawn('pactl', 'move-sink-input', str(index), n), self.queue_refresh()),
                        compact=True)
        volume = Volume(lambda v: spawn('pactl', 'set-sink-input-volume', str(index), f'{v}%'),
                        lambda: (spawn('pactl', 'set-sink-input-mute', str(index), 'toggle'),
                                 self.queue_refresh()))
        head = box(icon, box(name, detail, vertical=True, valign=Gtk.Align.CENTER, hexpand=True),
                   picker, spacing=12)
        widget = box(head, volume, vertical=True, spacing=8, css='card app')
        return dict(widget=widget, icon=icon, name=name, detail=detail, volume=volume, picker=picker)

    def toggle_mute(self, kind, target):
        spawn('pactl', f'set-{kind}-mute', target, 'toggle')
        self.queue_refresh()

    def set_default(self, kind, name):
        subprocess.run(['pactl', f'set-default-{kind}', name])
        if kind == 'sink':
            for s in pactl_json('sink-inputs'):
                spawn('pactl', 'move-sink-input', str(s['index']), name)
        self.queue_refresh()


class ClipboardPage(Page):
    name = 'clipboard'

    def __init__(self, app):
        super().__init__(app)
        os.makedirs(PINS, exist_ok=True)
        os.makedirs(THUMBS, exist_ok=True)
        self.search = Gtk.SearchEntry(placeholder_text='Search clipboard', hexpand=True)
        self.search.add_css_class('search')
        self.search.connect('search-changed', lambda *_: self.list.invalidate_filter())
        self.search.connect('activate', lambda *_: self.activate_first())
        self.search.connect('stop-search', lambda *_: app.hide())
        keys = Gtk.EventControllerKey()
        keys.connect('key-pressed', self.on_search_key)
        self.search.add_controller(keys)

        self.wipe = button(box(glyph('󰃢'), label('Clear', 'small'), spacing=6), self.on_wipe,
                           'pill', 'Clear the history (pins stay)')
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, css_classes=['clips'])
        self.list.set_activate_on_single_click(True)
        self.list.set_filter_func(self.filter)
        self.list.connect('row-activated', lambda _l, row: self.copy(row.ref))
        self.empty = box(glyph('󰅌', 'empty-glyph'), label('Nothing copied yet', 'dim', xalign=0.5),
                         vertical=True, spacing=6, css='empty')
        self.hint = label('Enter copies · hover a row to pin or delete', 'hint', xalign=0.5)

        content = box(page_header('Clipboard', self.wipe),
                      box(self.search, spacing=8),
                      self.list, self.empty,
                      vertical=True, spacing=12, css='page')
        self.widget = box(scrolled(content), self.hint, vertical=True)
        self.confirm_until = 0

    def shown(self):
        super().shown()
        self.search.set_text('')
        self.load()
        self.search.grab_focus()
        self.search.set_key_capture_widget(self.app.panel)

    def hidden(self):
        super().hidden()
        self.search.set_key_capture_widget(None)

    def on_search_key(self, _ctl, keyval, _code, _state):
        if keyval == Gdk.KEY_Down:
            row = self.first_visible()
            if row:
                row.grab_focus()
            return True
        return False

    def filter(self, row):
        query = self.search.get_text().strip().lower()
        return not query or query in row.text.lower()

    def first_visible(self):
        row = self.list.get_first_child()
        while row is not None:
            if isinstance(row, Gtk.ListBoxRow) and row.get_child_visible():
                return row
            row = row.get_next_sibling()
        return None

    def activate_first(self):
        row = self.first_visible()
        if row:
            self.copy(row.ref)

    def load(self):
        clear(self.list)
        entries = []
        for path in sorted((os.path.join(PINS, f) for f in os.listdir(PINS) if not f.startswith('.')),
                           key=os.path.getmtime, reverse=True):
            entries.append(('pin', path))
        history = output('cliphist', 'list').decode(errors='replace').splitlines()[:CLIP_LIMIT]
        entries += [('hist', line) for line in history if '\t' in line]
        todo = []
        keep = set()
        for kind, ref in entries:
            row, image_job = self.make_row(kind, ref)
            self.list.append(row)
            if image_job:
                todo.append(image_job)
                keep.add(image_job[1])
        self.empty.set_visible(not entries)
        if not output('sh', '-c', 'command -v cliphist'):
            self.empty.get_last_child().set_text('Install cliphist to keep a history')
        threading.Thread(target=self.load_images, args=(todo, keep), daemon=True).start()

    def make_row(self, kind, ref):
        pinned = kind == 'pin'
        image_job = None
        thumb = Gtk.Image(pixel_size=44, css_classes=['thumb'], overflow=Gtk.Overflow.HIDDEN)
        if pinned:
            mime = output('file', '-b', '--mime-type', ref).decode().strip()
            if mime.startswith('image/'):
                text, image_job = 'Image', (thumb, ref, None)
            else:
                with open(ref, 'rb') as f:
                    text = f.read(400).decode(errors='replace')
        else:
            text = ref.split('\t', 1)[1]
            m = re.match(r'\[\[ binary data .* (png|jpeg|jpg|webp|gif|bmp) (\d+x\d+) ]]', text)
            if m:
                path = os.path.join(THUMBS, ref.split('\t', 1)[0] + '.' + m[1])
                text, image_job = f'Image · {m[2]}', (thumb, path, ref)
        text = ' '.join(text.split())
        is_image = image_job is not None
        if not is_image:
            thumb = glyph('󰐃' if pinned else '󰦨', 'clip-glyph')
        body = label(text, 'clip-text', ellipsize=True, lines=1 if is_image else 2, hexpand=True)
        pin = button('󰐃' if pinned else '󰤱', lambda: self.pin(ref), 'round action' + (' on' if pinned else ''),
                     'Unpin' if pinned else 'Pin')
        delete = button('󰆴', lambda: self.delete(ref), 'round action', 'Delete')
        content = box(thumb, body, box(pin, delete, spacing=2, css='actions', valign=Gtk.Align.CENTER),
                      spacing=12, css='clip')
        row = Gtk.ListBoxRow(child=content)
        row.add_css_class('clip-row')
        if pinned:
            row.add_css_class('pinned')
        row.ref, row.text = ref, text
        return row, image_job

    def load_images(self, jobs, keep):
        for thumb, path, line in jobs:
            if line and not os.path.exists(path):
                data = output('cliphist', 'decode', data=(line + '\n').encode())
                with open(path, 'wb') as f:
                    f.write(data)
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
            except GLib.Error:
                continue
            GLib.idle_add(lambda t=thumb, p=pixbuf: t.set_from_paintable(square_texture(p)) and False)
        for name in os.listdir(THUMBS):
            path = os.path.join(THUMBS, name)
            if path not in keep:
                try:
                    os.remove(path)
                except OSError:
                    pass

    def data(self, ref):
        if ref.startswith(PINS):
            with open(ref, 'rb') as f:
                return f.read()
        return output('cliphist', 'decode', data=(ref + '\n').encode())

    def copy(self, ref):
        data = self.data(ref)
        try:
            proc = subprocess.Popen(['wl-copy'], stdin=subprocess.PIPE, start_new_session=True)
            proc.communicate(data, timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            pass
        self.app.hide()

    def pin(self, ref):
        if ref.startswith(PINS):
            os.remove(ref)
        else:
            data = self.data(ref)
            with open(os.path.join(PINS, hashlib.sha1(data).hexdigest()[:16]), 'wb') as f:
                f.write(data)
        self.load()

    def delete(self, ref):
        if ref.startswith(PINS):
            os.remove(ref)
        else:
            output('cliphist', 'delete', data=(ref + '\n').encode())
        self.load()

    def on_wipe(self):
        if time.monotonic() < self.confirm_until:
            output('cliphist', 'wipe')
            self.confirm_until = 0
            self.wipe.remove_css_class('danger')
            self.wipe.get_child().get_last_child().set_text('Clear')
            self.load()
            return
        self.confirm_until = time.monotonic() + 3
        self.wipe.add_css_class('danger')
        self.wipe.get_child().get_last_child().set_text('Sure?')

        def disarm():
            if time.monotonic() >= self.confirm_until:
                self.wipe.remove_css_class('danger')
                self.wipe.get_child().get_last_child().set_text('Clear')
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(3100, disarm)


