        content = box(page_header('Capture'), self.banner, vertical=True, spacing=12, css='page')
        for title, tiles in self.SECTIONS:
            grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True)
            for i, (g, text, cmd) in enumerate(tiles):
                tile = button(box(glyph(g, 'tile-glyph'), label(text, 'tile-text', xalign=0.5),
                                  vertical=True, spacing=8, valign=Gtk.Align.CENTER),
                              lambda c=cmd: self.run(c), 'tile' + (' rec' if cmd.startswith('rec') else ''))
                grid.attach(tile, i % 3, i // 3, 1, 1)
            content.append(label(title.upper(), 'heading'))
            content.append(grid)
        self.widget = scrolled(content)
        self.tick_source = 0

    def recording(self):
        try:
            with open(os.path.join(RUN, 'rec')) as f:
                pid, kind, start = f.read().split()[:3]
        except (OSError, ValueError):
            return None
        return (int(start), kind) if os.path.exists(f'/proc/{pid}') else None

    def shown(self):
        super().shown()
        self.tick()
        if not self.tick_source:
            self.tick_source = GLib.timeout_add(1000, self.tick)

    def tick(self):
        rec = self.recording()
        self.banner.set_visible(rec is not None)
        if rec:
            kind = 'GIF' if rec[1] == 'gif' else 'Recording'
            self.rec_label.set_text(f'{kind} · {clock(time.time() - rec[0])}')
        if not self.visible:
            self.tick_source = 0
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    def run(self, cmd):
        self.app.hide()
        GLib.timeout_add(250, lambda: spawn(CAPTURE, cmd) or False)

    def stop(self):
        spawn(CAPTURE, 'stop')
        GLib.timeout_add(600, lambda: self.tick() and False)


class Chart(Gtk.DrawingArea):
    def __init__(self, rgb, series, top=None):
        super().__init__(content_height=46, hexpand=True)
        self.rgb = rgb
        self.series = series
        self.top = top
        self.set_draw_func(self.draw)

    def draw(self, _area, cr, w, h):
        n = sysmon.HISTORY
        top = self.top or max([max(s, default=0) for s in self.series] + [1]) * 1.15
        for k, values in enumerate(self.series):
            pts = list(values)
            if len(pts) < 2:
                continue
            step = w / (n - 1)
            x0 = w - step * (len(pts) - 1)
            xy = [(x0 + i * step, h - 2 - (h - 4) * min(v, top) / top) for i, v in enumerate(pts)]
            cr.move_to(*xy[0])
            for (xa, ya), (xb, yb) in zip(xy, xy[1:]):
                mid = (xa + xb) / 2
                cr.curve_to(mid, ya, mid, yb, xb, yb)
            r, g, b = self.rgb if k == 0 else (0x94 / 255, 0xe2 / 255, 0xd5 / 255)
            if k == 0:
                path = cr.copy_path()
                cr.line_to(xy[-1][0], h)
                cr.line_to(xy[0][0], h)
                cr.close_path()
                grad = cairo.LinearGradient(0, 0, 0, h)
                grad.add_color_stop_rgba(0, r, g, b, 0.35)
                grad.add_color_stop_rgba(1, r, g, b, 0.0)
                cr.set_source(grad)
                cr.fill()
                cr.append_path(path)
            cr.set_source_rgba(r, g, b, 1)
            cr.set_line_width(2)
            cr.stroke()


class SystemPage(Page):
    name = 'system'

    def __init__(self, app):
        super().__init__(app)
        self.mon = sysmon.Monitor(procs=False)
        self.mon.measure()
        h = self.mon.hist
        self.cards = {}
        grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True)
        specs = [
            ('cpu', 'CPU', (0x89, 0xb4, 0xfa), [h['cpu']], 100),
            ('mem', 'Memory', (0xcb, 0xa6, 0xf7), [h['mem']], 100),
            ('temp', 'Temperature', (0xfa, 0xb3, 0x87), [h['temp']], 100),
            ('net', 'Network', (0xa6, 0xe3, 0xa1), [h['rx'], h['tx']], None),
        ]
        for i, (key, title, rgb, series, top) in enumerate(specs):
            value = label('—', 'stat-value')
            sub = label('', 'dim small', ellipsize=True)
            chart = Chart(tuple(c / 255 for c in rgb), series, top)
            card = box(label(title, 'stat-title'), value, sub, chart, vertical=True, spacing=2,
                       css=f'card stat stat-{key}')
            grid.attach(card, i % 2, i // 2, 1, 1)
            self.cards[key] = (value, sub, chart)

        self.procs = box(vertical=True, spacing=8)
        self.disk = Gtk.ProgressBar(css_classes=['meter'])
        self.disk_label = label('', 'dim small')
        self.swap = Gtk.ProgressBar(css_classes=['meter'])
        self.swap_label = label('', 'dim small')
        storage = box(box(label('Disk /', 'small', hexpand=True), self.disk_label), self.disk,
                      box(label('Swap', 'small', hexpand=True), self.swap_label), self.swap,
                      vertical=True, spacing=6, css='card')
        btop = button(box(glyph('󰄪'), label('btop', 'small'), spacing=6),
                      lambda: (app.hide(), spawn('alacritty', '--class', 'btop', '-e', 'btop')), 'pill')
        content = box(page_header('System', btop), grid,
                      label('BUSIEST', 'heading'), box(self.procs, css='card'),
                      storage, vertical=True, spacing=12, css='page')
        self.widget = scrolled(content)
        GLib.timeout_add(1000, self.sample)

    def shown(self):
        super().shown()
        self.mon.want_procs = True
        self.mon.processes()

        def first():
            self.mon.procs = self.mon.processes()
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(500, first)

    def hidden(self):
        super().hidden()
        self.mon.want_procs = False

    def sample(self):
        m = self.mon.measure()
        if not (self.visible and self.app.is_open()):
            return GLib.SOURCE_CONTINUE
        size, rate = sysmon.size, sysmon.rate
        v, s, c = self.cards['cpu']
        v.set_text(f"{m['cpu']:.0f}%")
        s.set_text(f"{os.cpu_count()} threads · load {os.getloadavg()[0]:.2f}")
        v, s, c2 = self.cards['mem']
        v.set_text(f"{m['mem']:.0f}%")
        s.set_text(f"{size(m['used'])} of {size(m['total'])}")
        v, s, c3 = self.cards['temp']
        v.set_text(f"{m['temp']:.0f}°C" if m['temp'] is not None else '—')
        s.set_text('CPU package')
        v, s, c4 = self.cards['net']
        v.set_text(f"↓ {rate(m['rx'])}")
        s.set_text(f"↑ {rate(m['tx'])}")
        for chart in (c, c2, c3, c4):
            chart.queue_draw()
        for key, (value, *_r) in self.cards.items():
            level = {'cpu': m['cpu'], 'mem': m['mem'], 'temp': m['temp'] or 0}.get(key, 0)
            value.set_css_classes(['stat-value'] + (['crit'] if level >= 90 else ['warn'] if level >= 80 else []))

        clear(self.procs)
        for pct, name in m['procs'][:6]:
            bar = Gtk.ProgressBar(css_classes=['meter', 'thin'], fraction=min(pct / 100, 1))
            self.procs.append(box(box(label(name, 'small', ellipsize=True, hexpand=True),
                                      label(f'{pct:.1f}%', 'readout small')),
                                  bar, vertical=True, spacing=4))
        if not m['procs']:
            self.procs.append(label('Measuring…', 'dim small'))
        self.disk.set_fraction(m['disk'] / 100)
        self.disk_label.set_text(f"{m['disk']:.0f}%")
        swap_frac = m['swap'] / m['swap_total'] if m['swap_total'] else 0
        self.swap.set_fraction(swap_frac)
        self.swap_label.set_text(f"{size(m['swap'])} of {size(m['swap_total'])}" if m['swap_total'] else 'off')
        return GLib.SOURCE_CONTINUE


class Ring(Gtk.DrawingArea):
    def __init__(self):
        super().__init__(content_width=176, content_height=176, halign=Gtk.Align.CENTER)
        self.fraction = 0.0
        self.paused = False
        self.set_draw_func(self.draw)

    def draw(self, _area, cr, w, h):
        r = min(w, h) / 2 - 10
        cx, cy = w / 2, h / 2
        cr.set_line_width(10)
        cr.set_source_rgba(1, 1, 1, 0.07)
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.stroke()
        if self.fraction > 0:
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            if self.paused:
                cr.set_source_rgba(0xa6 / 255, 0xad / 255, 0xc8 / 255, 1)
            else:
                cr.set_source_rgba(0xfa / 255, 0xb3 / 255, 0x87 / 255, 1)
            start = -math.pi / 2
            cr.arc(cx, cy, r, start, start + 2 * math.pi * self.fraction)
            cr.stroke()


